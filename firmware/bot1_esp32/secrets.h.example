// Copy this file to secrets.h and fill in your values. secrets.h is gitignored.
#pragma once

// Your local WiFi (the same network the Pi is on).
#define WIFI_SSID   "your-wifi-name"
#define WIFI_PASS   "your-wifi-password"

// The Pi relay on the local network: its LAN IP and the relay's listen_port.
#define RELAY_HOST  "192.168.1.50"
#define RELAY_PORT  8100

// The laptop brain's API key (from brain/config.toml). Reserved for future use
// if the ESP32 ever talks to the brain directly; the relay currently holds the
// key, so this can stay a placeholder for now.
#define API_KEY     "unused-for-now"
