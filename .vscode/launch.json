{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Venus: debug cockpit",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\brain\\serve.py",
      "cwd": "${workspaceFolder}\\brain",
      "console": "integratedTerminal",
